{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beyond10x:agentic-principles:schema:transcript-coding:1",
  "title": "Agent transcript coding",
  "description": "A coded observation of agent actions around a selected transcript point.",
  "type": "object",
  "required": ["schema", "created", "source", "coding_point", "actions", "observed_result"],
  "properties": {
    "schema": {
      "const": "urn:beyond10x:agentic-principles:schema:transcript-coding:1"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "source": {"$ref": "#/$defs/source"},
    "coding_point": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "observed_result": {"$ref": "#/$defs/observedResult"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:-[a-z0-9_]+)*$"
    },
    "source": {
      "type": "object",
      "required": ["kind", "date", "timezone", "stable_run_id", "limitation"],
      "properties": {
        "kind": {"const": "authorized_current_session"},
        "date": {"type": "string", "format": "date"},
        "timezone": {"type": "string", "minLength": 1},
        "stable_run_id": {"type": ["string", "null"]},
        "limitation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action", "classification", "required_capabilities", "eventual_outcome"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "classification": {
          "enum": ["safe_independent", "blocked_by_unavailable_capability", "already_complete"]
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "eventual_outcome": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observedResult": {
      "type": "object",
      "required": [
        "safe_independent_actions_at_yield",
        "safe_independent_actions_later_completed_during_outage",
        "blocked_actions_at_yield",
        "blocked_actions_attempted_during_outage",
        "invalid_external_effects_observed",
        "operator_intervention_required_to_resume_safe_work"
      ],
      "properties": {
        "safe_independent_actions_at_yield": {"type": "integer", "minimum": 0},
        "safe_independent_actions_later_completed_during_outage": {"type": "integer", "minimum": 0},
        "blocked_actions_at_yield": {"type": "integer", "minimum": 0},
        "blocked_actions_attempted_during_outage": {"type": "integer", "minimum": 0},
        "invalid_external_effects_observed": {"type": "integer", "minimum": 0},
        "operator_intervention_required_to_resume_safe_work": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
